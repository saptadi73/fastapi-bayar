APP_NAME=Payment Portal
ENVIRONMENT=development
APP_DEBUG=true
API_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
TIMEZONE=UTC
DATABASE_URL=postgresql+asyncpg://openpg:CHANGE_ME@127.0.0.1:5432/bayar
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false
AUTO_CREATE_TABLES=false
AUTH_ENABLED=true
ADMIN_ENABLED=false
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_IDLE_TTL_SECONDS=1800
ADMIN_LOGIN_LIMIT=10
ADMIN_LOGIN_WINDOW_SECONDS=300
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_48_CHARS
JWT_ISSUER=payment-portal
JWT_AUDIENCE=payment-client-api
ACCESS_TOKEN_TTL_SECONDS=600
CHECKOUT_TTL_SECONDS=1800
HMAC_CLOCK_SKEW_SECONDS=300
NONCE_TTL_SECONDS=600
IDEMPOTENCY_TTL_HOURS=48
CLIENT_API_SECRET=change-me-local-only
DOKU_ENABLED=false
DOKU_ENVIRONMENT=SANDBOX
DOKU_SANDBOX_BASE_URL=https://api-sandbox.doku.com
DOKU_PRODUCTION_BASE_URL=https://api.doku.com
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PUBLIC_KEY=
MIDTRANS_ENABLED=false
MIDTRANS_ENVIRONMENT=SANDBOX
MIDTRANS_SANDBOX_BASE_URL=https://app.sandbox.midtrans.com
MIDTRANS_PRODUCTION_BASE_URL=https://app.midtrans.com
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_CORE_SANDBOX_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_CORE_PRODUCTION_BASE_URL=https://api.midtrans.com
GATEWAY_TIMEOUT_SECONDS=15
CALLBACK_TIMEOUT_SECONDS=10
CALLBACK_MAX_ATTEMPTS=7
WORKER_CALLBACK_INTERVAL_SECONDS=5
WORKER_CLEANUP_INTERVAL_SECONDS=300
WORKER_CALLBACK_BATCH_SIZE=20
WORKER_CLEANUP_BATCH_SIZE=500
WORKER_RECONCILIATION_INTERVAL_SECONDS=60
WORKER_RECONCILIATION_BATCH_SIZE=10
WORKER_REFUND_INTERVAL_SECONDS=30
WORKER_REFUND_BATCH_SIZE=10
REDIS_URL=redis://127.0.0.1:6379/2
SENTRY_DSN=
