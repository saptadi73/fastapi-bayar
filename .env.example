APP_NAME=Payment Portal
ENVIRONMENT=development
APP_DEBUG=true
API_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
TIMEZONE=UTC
DATABASE_URL=postgresql+asyncpg://openpg:CHANGE_ME@127.0.0.1:5432/bayar
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false
AUTO_CREATE_TABLES=false
MIGRATION_GATE_ENABLED=true
MIGRATION_HEAD=20260918_0031
AUTH_ENABLED=true
ADMIN_ENABLED=false
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_IDLE_TTL_SECONDS=1800
ADMIN_LOGIN_LIMIT=10
ADMIN_LOGIN_WINDOW_SECONDS=300
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_48_CHARS
JWT_ISSUER=payment-portal
JWT_AUDIENCE=payment-client-api
ACCESS_TOKEN_TTL_SECONDS=600
CHECKOUT_TTL_SECONDS=1800
HMAC_CLOCK_SKEW_SECONDS=300
NONCE_TTL_SECONDS=600
IDEMPOTENCY_TTL_HOURS=48
CLIENT_API_SECRET=change-me-local-only
# Fernet key; generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
DOKU_ENABLED=false
DOKU_ENVIRONMENT=SANDBOX
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_SANDBOX_BASE_URL=https://api-sandbox.doku.com
DOKU_PRODUCTION_BASE_URL=https://api.doku.com
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PUBLIC_KEY=
DOKU_TIMESTAMP_TOLERANCE_SECONDS=300
# Product-specific DOKU settings; live secrets must stay in deployment secret storage.
DOKU_CHECKOUT_PATH=/checkout/v1/payment
DOKU_PAYMENT_DUE_MINUTES=60
DOKU_NOTIFICATION_BASE_URL=http://localhost:8000
DOKU_NOTIFICATION_PATH=/api/v1/webhooks/doku
DOKU_CALLBACK_URL=http://localhost:8000/api/v1/payments/doku/return
DOKU_SNAP_PARTNER_ID=
DOKU_SNAP_CLIENT_SECRET=
DOKU_SNAP_PRIVATE_KEY_PATH=.secrets/doku-snap-private.pem
DOKU_SNAP_DOKU_PUBLIC_KEY_PATH=.secrets/doku-snap-doku-public.pem
DOKU_SNAP_DOKU_CLIENT_ID=
DOKU_SNAP_VA_CHANNELS_JSON={}
DOKU_SNAP_CHANNEL_ID=H2H
DOKU_SNAP_TOKEN_PATH=/authorization/v1/access-token/b2b
DOKU_SNAP_VA_CREATE_PATH=/virtual-accounts/bi-snap-va/v1.1/transfer-va/create-va
DOKU_SNAP_MERCHANT_TOKEN_PATH=/api/v1/doku/snap/authorization/v1/access-token/b2b
DOKU_SNAP_TOKEN_TTL_SECONDS=900
DOKU_SNAP_TIMESTAMP_TOLERANCE_SECONDS=300
MIDTRANS_ENABLED=false
MIDTRANS_ENVIRONMENT=SANDBOX
MIDTRANS_IS_PRODUCTION=false
# Set MIDTRANS_ENVIRONMENT=PRODUCTION only after rotated live keys and approved UAT.
MIDTRANS_SANDBOX_BASE_URL=https://app.sandbox.midtrans.com
MIDTRANS_PRODUCTION_BASE_URL=https://app.midtrans.com
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_CORE_SANDBOX_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_CORE_PRODUCTION_BASE_URL=https://api.midtrans.com
GATEWAY_TIMEOUT_SECONDS=15
CALLBACK_TIMEOUT_SECONDS=10
CALLBACK_MAX_ATTEMPTS=7
WORKER_CALLBACK_INTERVAL_SECONDS=5
WORKER_CLEANUP_INTERVAL_SECONDS=300
WORKER_CALLBACK_BATCH_SIZE=20
WORKER_CLEANUP_BATCH_SIZE=500
WORKER_RECONCILIATION_INTERVAL_SECONDS=60
WORKER_RECONCILIATION_BATCH_SIZE=10
WORKER_RECONCILIATION_MAX_ATTEMPTS=3
WORKER_RECONCILIATION_BACKOFF_SECONDS=30
WORKER_REFUND_INTERVAL_SECONDS=30
WORKER_REFUND_BATCH_SIZE=10
REDIS_URL=redis://127.0.0.1:6379/2
SENTRY_DSN=
